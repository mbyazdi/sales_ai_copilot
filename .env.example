# Process environment only; Django does not automatically load this file.
# Local development/demo uses the approved PostgreSQL startup profile.
# Without explicit process configuration, Django retains its SQLite fallback.
DB_ENGINE=postgresql
POSTGRES_DB=sales_ai_db
POSTGRES_USER=sales_ai_runtime
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONNECT_TIMEOUT=5
# For remote environments use verify-full and configure libpq PGSSLROOTCERT.
